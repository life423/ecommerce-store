# Optional. Without this value, the API runs with database features disabled.
# Start MongoDB with `npm run db:up`, then uncomment and restart the API.
# MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
ENABLE_CATALOG_EDITOR=true
STORE_URL=http://localhost:5173
# Test keys only. Leave blank to keep the cart usable with checkout disabled.
STRIPE_SECRET_KEY=
# Supplied by `npm run stripe:listen`; needed to enable checkout.
STRIPE_WEBHOOK_SECRET=
